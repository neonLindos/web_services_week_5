@model List<TaskItem>
@{ ViewData["Title"] = "Задачи"; }
<h1>Задачи</h1>
<p><a asp-action="Create">Добавить запись</a></p>
<form asp-action="Details" method="get"><label for="id">Найти по ID</label>
<input id="id" name="id" type="number" min="1" required /><button type="submit">Найти</button></form>
@if (Model.Count == 0 && ViewBag.Error == null) { <p>Записей пока нет.</p> }
<table><thead><tr><th>ID</th><th>Название</th><th>Описание</th><th>Выполнено</th><th>Действия</th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td>@item.Id</td><td>@item.Title</td><td>@item.Description</td><td>@(item.IsCompleted ? "Выполнено" : "В работе")</td><td>
<a asp-action="Details" asp-route-id="@item.Id">Подробнее</a>
<a asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
<a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
</td></tr>
}
</tbody></table>
