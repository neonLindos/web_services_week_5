@model Student
@{ var action = Model.Id == 0 ? "Create" : "Edit"; ViewData["Title"] = Model.Id == 0 ? "Добавить запись" : "Изменить запись"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="@action" asp-route-id="@Model.Id" method="post">
<div asp-validation-summary="All" class="error" role="alert"></div>
<input asp-for="Id" type="hidden" />
<div class="field"><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName"></span></div>
<div class="field"><label asp-for="Group"></label><input asp-for="Group" /><span asp-validation-for="Group"></span></div>
<div class="field"><label asp-for="Course"></label><input asp-for="Course" /><span asp-validation-for="Course"></span></div>
<div class="field"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div>
<button type="submit">Сохранить</button> <a asp-action="Index">Отмена</a>
</form>
